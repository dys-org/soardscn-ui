{
  "name": "soardscn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "registry:build": "shadcn build && node scripts/organize-registry.mjs",
    "preview": "vite preview",
    "test": "vitest run --browser",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check": "pnpm typecheck && prettier --write .",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "shadcn": "^3.8.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^3.2.4",
    "lint-staged": "^16.3.2",
    "playwright": "^1.55.0",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^3.0.5",
    "vitest-browser-react": "^1.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,css,html,json,md,yml,yaml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm exec lint-staged",
    "pre-push": "pnpm test"
  }
}
